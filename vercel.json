{
  "functions": {
    "api/ubiquity.js": {
      "includeFiles": "api/{_ubiquity,_gud}/**"
    },
    "api/outfit.js": {
      "includeFiles": "api/{_locked,_private}/**"
    },
    "api/me.js": {
      "includeFiles": "api/{_private/index.enc,_locked/gud-index.enc,_locked/wdm-index.enc}"
    },
    "api/profile.js": {
      "includeFiles": "api/_private/index.enc"
    }
  },
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/stand",
      "destination": "/api/skin?stand=1"
    },
    {
      "source": "/profiles/:name",
      "destination": "/profile"
    }
  ]
}
