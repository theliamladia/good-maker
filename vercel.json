{
  "functions": {
    "api/ubiquity.js": {
      "includeFiles": "api/{_ubiquity,_gud}/**"
    },
    "api/outfit.js": {
      "includeFiles": "api/{_locked,_private}/**"
    }
  },
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/stand",
      "destination": "/api/skin?stand=1"
    },
    {
      "source": "/profiles/:name",
      "destination": "/profile"
    }
  ]
}
